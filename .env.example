# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive — OAuth2 access token
# Get from: https://developers.google.com/oauthplayground
# Scope: https://www.googleapis.com/auth/drive.readonly
GOOGLE_ACCESS_TOKEN=ya29.xxx

# LLM
ANTHROPIC_API_KEY=sk-ant-...
# Gemini key — required only if gemini is the primary or fallback provider
GEMINI_API_KEY=
# Active provider: "anthropic" (default) or "gemini"
LLM_PROVIDER=anthropic
# Optional fallback provider — a failed primary call is retried once here (resilience).
# e.g. LLM_PROVIDER=anthropic + LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=
# Optional model overrides (default per provider otherwise)
LLM_MODEL=
LLM_FALLBACK_MODEL=

# API auth gate (shared secret for run route)
RUN_API_SECRET=a-long-random-secret

# Resume chain UUID (from the DB row you inserted)
NEXT_PUBLIC_RESUME_CHAIN_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_RUN_API_SECRET=same-as-RUN_API_SECRET
